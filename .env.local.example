# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Used only in secured server-side API routes, never exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Notification Email / Webhook Integrations
NOTIFICATION_WEBHOOK_URL=
ADMIN_NOTIFICATION_EMAIL=admin@ecreation.in

# Site URL for metadata and canonical links
NEXT_PUBLIC_SITE_URL=https://ecreation.in
